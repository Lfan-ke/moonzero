// The native discovery driver: it gives moonzero's persisted registry real I/O by
// reading and writing a real file through `moonbitlang/async`'s fs, and a live
// watcher that reloads on file change. Native-only, because `moonbitlang/async`
// (real files, the OS watch backend) has no JS/Wasm backend.
supported_targets = "native"

import {
  "Lfan-ke/moonzero",
  "Lfan-ke/moonrpc",
  "Lfan-ke/moonrpc/net",
  "moonbitlang/async/fs",
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
}

import {
  "Lfan-ke/moonapi",
  "Lfan-ke/moonasgi",
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
} for "test"
