// Type aliases
pub type BidiStreamFactory = () -> BidiStreamHandler

pub type ClientStreamHandler = (Array[Bytes]) -> Bytes

pub type Middleware = (async (@moonasgi.Scope, async () -> @moonasgi.Event, async (@moonasgi.Event) -> Unit) -> Unit) -> async (@moonasgi.Scope, async () -> @moonasgi.Event, async (@moonasgi.Event) -> Unit) -> Unit

