// Drives the assembled ASGI onion in-process, so it awaits the async app the
// metrics middleware wraps — native-only, like moonzero's other async edges.
supported_targets = "native"

import {
  "Lfan-ke/moonzero",
  "Lfan-ke/moonapi",
  "Lfan-ke/moonasgi",
  "moonbitlang/async",
}

pkgtype(kind: "executable")
